# Copie para .env (nunca versione o .env). Valem para a API (uvicorn backend.main:app) e para o docker-compose.

# ---- obrigatórias em produção ------------------------------------------------------------
RIBEIRO_AMBIENTE=desenvolvimento        # "producao" exige RIBEIRO_JWT_SEGREDO (>= 32 caracteres)
RIBEIRO_JWT_SEGREDO=                    # gere com: openssl rand -hex 32
POSTGRES_PASSWORD=                      # só para o docker-compose (a senha do Postgres do compose)

# ---- banco e arquivos --------------------------------------------------------------------
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco   # (Railway/Heroku já fornecem). Sem isto: SQLite em <pasta_dados>/ribeiro.db
# RIBEIRO_PASTA_DADOS=./data                                # PDFs enviados. Em produção: um volume (Docker: /data)

# ---- primeiro administrador (criado só se o banco ainda não tiver usuários) --------------
RIBEIRO_ADMIN_EMAIL=
RIBEIRO_ADMIN_SENHA=                    # mínimo de 10 caracteres
# RIBEIRO_ADMIN_NOME=Administrador

# ---- rede --------------------------------------------------------------------------------
RIBEIRO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # endereço(s) do frontend, separados por vírgula
# NEXT_PUBLIC_API_URL=http://localhost:8000   # endereço da API visto pelo NAVEGADOR (gravado no build do frontend)
# API_PORT=8000
# FRONTEND_PORT=3000
# FORWARDED_ALLOW_IPS=*                       # atrás de proxy (Railway): para o limite de login ver o IP real

# ---- ajustes (valores padrão) ------------------------------------------------------------
# RIBEIRO_TOKEN_MINUTOS=480               # validade do login
# RIBEIRO_LINK_PDF_SEGUNDOS=120           # validade do link assinado para abrir o PDF
# RIBEIRO_LOGIN_MAX_TENTATIVAS=5          # falhas seguidas (IP + e-mail) antes do bloqueio
# RIBEIRO_LOGIN_JANELA_SEGUNDOS=900
# RIBEIRO_REGISTRO_MAX_POR_IP=5           # cadastros pelo "Registre-se" aceitos de um mesmo IP na janela abaixo
# RIBEIRO_REGISTRO_JANELA_SEGUNDOS=3600
# RIBEIRO_MAX_PDF_MB=200
# RIBEIRO_MAX_ARQUIVOS_POR_ENVIO=20
# RIBEIRO_WORKERS_ANALISE=2               # análises simultâneas
# RIBEIRO_SSE_DURACAO_MAXIMA=30           # segundos que o acompanhamento ao vivo fica aberto antes de o navegador reabri-lo (reduza se o seu proxy corta conexões mais curtas)

# ---- camada de IA (backend/ai_services, POST /api/ia/analise) -----------------------------
# Opcional: sem a chave, só essa rota responde 503. O texto dos autos (sem a capa e com CPF/CNPJ/e-mail/telefone mascarados) vai para a OpenAI.
OPENAI_API_KEY=                         # ou RIBEIRO_OPENAI_API_KEY
# RIBEIRO_IA_MODELO=gpt-5-nano
# RIBEIRO_IA_ESFORCO=low                  # minimal | low | medium | high (esforço de raciocínio; só para modelos gpt-5 e o*)
# RIBEIRO_IA_TIMEOUT_SEGUNDOS=180
# RIBEIRO_IA_MAX_CARACTERES=1000000       # teto do texto enviado ao modelo (~285 mil tokens); acima disso a rota responde 413
